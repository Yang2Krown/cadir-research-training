FUNCTION goa_per_cluster 
function (cadir, universe, org, set = "CellMarker", min_size = 10, 
    max_size = 500, filter_literature = FALSE, verbose = TRUE) 
{
    stopifnot(is(cadir, "cadir"))
    suppressWarnings({
        cadir <- rm_monoclusters(cadir)
    })
    gs <- load_ct_gene_set(set = set, org = org)
    gene_sets <- make_gene_set_list(gs, filter_literature = filter_literature)
    gc <- cadir@gene_clusters
    gc_names <- sort(unique(gc))
    gc_list <- lapply(X = gc_names, FUN = function(x) {
        names(gc[which(gc == gc_names[x])])
    })
    names(gc_list) <- gc_names
    gse_res <- list()
    for (c in seq_len(length(gc_list))) {
        gene <- gc_list[[c]]
        clst_name <- names(gc_list)[c]
        goa <- compute_goa(gois = gene, gene_sets = gene_sets, 
            universe = universe, min_size = min_size, max_size = max_size, 
            verbose = verbose)
        gse_res[[clst_name]] <- goa
    }
    return(gse_res)
}
